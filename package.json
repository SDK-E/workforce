{
  "name": "@workforce/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13 <27",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "test": "pnpm format:check && pnpm lint && pnpm build && node --test dist/test/**/*.test.js",
    "dev": "tsx src/cli.tsx",
    "tui": "pnpm start",
    "doctor": "pnpm build && node dist/src/doctor.js",
    "sandbox:plan": "pnpm build && node dist/src/plan-cli.js",
    "arm:design": "pnpm build && node dist/src/arm-cli.js",
    "images:build": "sh scripts/build-images.sh",
    "images:verify-size": "sh scripts/verify-image-sizes.sh",
    "egress:setup": "sh scripts/setup-egress.sh",
    "sandbox:verify": "sh scripts/verify-sandbox.sh",
    "start": "node scripts/check-node.mjs && node dist/src/cli.js",
    "package": "pnpm build && pnpm pack --ignore-scripts"
  },
  "dependencies": {
    "execa": "10.0.1",
    "ink": "6.3.1",
    "ink-select-input": "6.2.0",
    "ink-text-input": "6.0.0",
    "pino": "10.3.1",
    "react": "19.1.1",
    "xstate": "5.31.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "eslint": "10.9.0",
    "ink-testing-library": "4.0.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0"
  }
}
