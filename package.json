{
  "name": "@workforce/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13 <27",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'test/**/*.ts'",
    "test": "pnpm format:check && pnpm build && node --test dist/test/**/*.test.js",
    "dev": "tsx src/cli.tsx",
    "tui": "pnpm start",
    "doctor": "pnpm build && node dist/src/doctor.js",
    "sandbox:plan": "pnpm build && node dist/src/plan-cli.js",
    "arm:design": "pnpm build && node dist/src/arm-cli.js",
    "images:build": "sh scripts/build-images.sh",
    "sandbox:verify": "sh scripts/verify-sandbox.sh",
    "start": "node scripts/check-node.mjs && node dist/src/cli.js",
    "package": "pnpm build && pnpm pack --ignore-scripts"
  },
  "dependencies": {
    "ink": "6.3.1",
    "react": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
