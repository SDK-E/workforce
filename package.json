{
  "name": "@workforce/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13 <27",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "dead-code:check": "knip",
    "test": "pnpm format:check && pnpm lint && pnpm dead-code:check && pnpm build && node --test dist/test/**/*.test.js",
    "dev": "tsx src/daemon.ts",
    "tui": "sh scripts/open-tui.sh",
    "doctor": "pnpm build && node dist/src/doctor.js",
    "secrets:import": "sh scripts/import-secret.sh",
    "workforce:mcp": "pnpm build && node dist/src/workforce-mcp/workforce-mcp-stdio.js",
    "images:build": "sh scripts/build-images.sh",
    "images:verify-size": "sh scripts/verify-image-sizes.sh",
    "egress:setup": "sh scripts/setup-egress.sh",
    "sandbox:verify": "sh scripts/verify-sandbox.sh",
    "start": "sh scripts/start-workforce.sh",
    "stop": "sh scripts/stop-workforce.sh",
    "reset": "sh scripts/reset-workforce.sh",
    "status": "docker compose ps workforce-engine",
    "logs": "docker compose logs --follow workforce-engine",
    "package": "pnpm build && pnpm pack --ignore-scripts"
  },
  "knip": {
    "entry": [
      "src/doctor.ts",
      "src/secrets-cli.ts",
      "src/tui-client.tsx",
      "src/workforce-mcp/workforce-mcp-stdio.ts",
      "test/**/*.{test.ts,test.tsx}"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "test/**/*.{ts,tsx}"
    ],
    "ignoreDependencies": [
      "ink-testing-library"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cron-parser": "^5.10.0",
    "execa": "10.0.1",
    "ink": "6.3.1",
    "ink-select-input": "6.2.0",
    "ink-text-input": "6.0.0",
    "pino": "10.3.1",
    "react": "19.1.1",
    "tar": "7.5.22",
    "xstate": "5.31.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "eslint": "10.9.0",
    "ink-testing-library": "4.0.0",
    "knip": "6.32.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0"
  }
}
